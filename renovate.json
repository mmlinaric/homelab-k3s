{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": true,
  "automerge": false,
  "constraints": {
    "jenkins": "2.568.2"
  },
  "argocd": {
    "managerFilePatterns": ["/clusters/.+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/(apps|platform)/.+\\.yaml$/"]
  },
  "packageRules": [
    {
      "matchManagers": ["argocd", "kubernetes"],
      "groupName": "cluster dependencies"
    },
    {
      "matchManagers": ["argocd"],
      "matchPackageNames": ["longhorn", "velero"],
      "minimumReleaseAge": "7 days",
      "dependencyDashboardApproval": true
    },
    {
      "matchPackageNames": ["python", "ansible-core", "ansible-lint", "yamllint"],
      "groupName": "CI Python toolchain"
    },
    {
      "matchDatasources": ["jenkins-plugins"],
      "groupName": "Jenkins plugins",
      "constraintsFiltering": "strict"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^clusters/homelab/applications/jenkins\\.yaml$/"],
      "matchStrings": ["            - (?<depName>[a-zA-Z0-9_.-]+):(?<currentValue>[^\\s]+)"],
      "datasourceTemplate": "jenkins-plugins",
      "versioningTemplate": "loose"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/ansible/group_vars/all\\.yml$/"],
      "matchStrings": ["k3s_version: (?<currentValue>[^\\s]+)"],
      "depNameTemplate": "k3s-io/k3s",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/ansible/group_vars/all\\.yml$/"],
      "matchStrings": ["helm_version: (?<currentValue>[^\\s]+)"],
      "depNameTemplate": "helm/helm",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/ansible/group_vars/all\\.yml$/"],
      "matchStrings": ["kube_vip_version: (?<currentValue>[^\\s]+)"],
      "depNameTemplate": "kube-vip/kube-vip",
      "datasourceTemplate": "github-releases"
    }
  ]
}
