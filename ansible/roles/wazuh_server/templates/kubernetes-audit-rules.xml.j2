<group name="kubernetes_audit,k3s,">
  <rule id="100200" level="3">
    <decoded_as>json</decoded_as>
    <field name="apiVersion" type="pcre2">^audit\.k8s\.io/v1$</field>
    <description>Kubernetes API audit event.</description>
  </rule>

  <rule id="100201" level="7">
    <if_sid>100200</if_sid>
    <field name="responseStatus.code" type="pcre2">^(?:401|403)$</field>
    <description>Kubernetes API request was denied.</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100202" level="10">
    <if_sid>100201</if_sid>
    <field name="user.username" type="pcre2">^(?:oidc:|system:anonymous)</field>
    <description>Kubernetes API request from an interactive or anonymous identity was denied.</description>
    <group>authentication_failed,</group>
  </rule>

  <rule id="100203" level="10">
    <if_sid>100200</if_sid>
    <field name="objectRef.subresource" type="pcre2">^(?:exec|attach|portforward)$</field>
    <description>Interactive access to a Kubernetes workload.</description>
    <group>command_execution,</group>
  </rule>

  <rule id="100204" level="12">
    <if_sid>100200</if_sid>
    <field name="objectRef.resource" type="pcre2">^serviceaccounts$</field>
    <field name="objectRef.subresource" type="pcre2">^token$</field>
    <field name="user.username" type="pcre2">^(?:oidc:|system:admin$)</field>
    <description>Interactive Kubernetes identity requested a service account token.</description>
    <group>credential_access,</group>
  </rule>

  <rule id="100205" level="10">
    <if_sid>100200</if_sid>
    <field name="verb" type="pcre2">^(?:create|update|patch|delete|deletecollection)$</field>
    <field name="objectRef.resource" type="pcre2">^(?:roles|rolebindings|clusterroles|clusterrolebindings)$</field>
    <description>Kubernetes RBAC configuration was changed.</description>
    <group>configuration_changed,privilege_escalation,</group>
  </rule>

  <rule id="100206" level="12">
    <if_sid>100200</if_sid>
    <field name="verb" type="pcre2">^(?:delete|deletecollection)$</field>
    <field name="objectRef.resource" type="pcre2">^(?:namespaces|customresourcedefinitions)$</field>
    <description>Critical Kubernetes API resource was deleted.</description>
    <group>configuration_changed,</group>
  </rule>

  <rule id="100207" level="10">
    <if_sid>100200</if_sid>
    <field name="verb" type="pcre2">^(?:get|list|watch)$</field>
    <field name="objectRef.resource" type="pcre2">^secrets$</field>
    <field name="user.username" type="pcre2">^(?:oidc:|system:admin$)</field>
    <description>Interactive Kubernetes identity accessed Secret metadata.</description>
    <group>credential_access,</group>
  </rule>

  <rule id="100208" level="8">
    <if_sid>100200</if_sid>
    <field name="verb" type="pcre2">^(?:create|update|patch|delete|deletecollection)$</field>
    <field name="objectRef.resource" type="pcre2">^(?:secrets|serviceaccounts)$</field>
    <description>Kubernetes credential-bearing resource was changed.</description>
    <group>configuration_changed,</group>
  </rule>

  <rule id="100211" level="0">
    <if_sid>100200</if_sid>
    <field name="user.username" type="pcre2">^system:serviceaccount:kube-system:namespace-controller$</field>
    <field name="verb" type="pcre2">^(?:update|delete|deletecollection)$</field>
    <description>Routine Kubernetes namespace finalization activity.</description>
  </rule>

  <rule id="100209" level="6">
    <if_sid>100200</if_sid>
    <field name="verb" type="pcre2">^(?:create|update|patch|delete|deletecollection)$</field>
    <field name="objectRef.resource" type="pcre2">^(?:pods|deployments|daemonsets|statefulsets|jobs|cronjobs)$</field>
    <description>Kubernetes workload was changed.</description>
    <group>configuration_changed,</group>
  </rule>

  <rule id="100210" level="5">
    <if_sid>100200</if_sid>
    <field name="verb" type="pcre2">^(?:create|update|patch|delete|deletecollection)$</field>
    <description>Kubernetes API resource was changed.</description>
    <group>configuration_changed,</group>
  </rule>

  <!-- Keep high-severity defaults for unknown identities.  These children only
       demote exact, observed controller and scheduled-backup activity. -->
  <rule id="100213" level="1">
    <if_sid>100205</if_sid>
    <field name="user.username" type="pcre2">^system:serviceaccount:cnpg-system:cloudnative-pg$</field>
    <field name="verb" type="pcre2">^create$</field>
    <field name="objectRef.resource" type="pcre2">^rolebindings$</field>
    <field name="responseStatus.code" type="pcre2">^409$</field>
    <description>CloudNativePG found its existing RoleBinding during reconciliation.</description>
    <group>audit_benign,controller_reconciliation,</group>
  </rule>

  <rule id="100214" level="3">
    <if_sid>100203</if_sid>
    <field name="user.username" type="pcre2">^system:serviceaccount:forgejo:forgejo-backup$</field>
    <field name="objectRef.namespace" type="pcre2">^forgejo$</field>
    <field name="objectRef.subresource" type="pcre2">^exec$</field>
    <description>Forgejo scheduled backup executed its database workflow.</description>
    <group>audit_benign,scheduled_backup,</group>
  </rule>

  <rule id="100215" level="3">
    <if_sid>100203</if_sid>
    <field name="user.username" type="pcre2">^system:serviceaccount:velero:velero-server$</field>
    <field name="objectRef.namespace" type="pcre2">^(?:forgejo|dependency-track|keycloak)$</field>
    <field name="objectRef.subresource" type="pcre2">^exec$</field>
    <description>Velero executed an approved application backup hook.</description>
    <group>audit_benign,scheduled_backup,</group>
  </rule>

  <rule id="100216" level="1">
    <if_sid>100200</if_sid>
    <field name="user.username" type="pcre2">^(?:system:k3s-supervisor|system:kube-controller-manager|system:apiserver)$</field>
    <field name="verb" type="pcre2">^(?:get|watch)$</field>
    <field name="objectRef.resource" type="pcre2">^secrets$</field>
    <field name="responseStatus.code" type="pcre2">^200$</field>
    <description>Routine control-plane Secret metadata watch.</description>
    <group>audit_benign,controller_reconciliation,</group>
  </rule>

  <rule id="100217" level="1">
    <if_sid>100210</if_sid>
    <field name="verb" type="pcre2">^create$</field>
    <field name="objectRef.resource" type="pcre2">^tokenreviews$</field>
    <field name="responseStatus.code" type="pcre2">^201$</field>
    <description>Routine Kubernetes TokenReview request.</description>
    <group>audit_benign,authentication_service,</group>
  </rule>

  <rule id="100218" level="1">
    <if_sid>100210</if_sid>
    <field name="user.username" type="pcre2">^(?:system:k3s-supervisor|system:node:k3s-01)$</field>
    <field name="verb" type="pcre2">^(?:patch|update)$</field>
    <field name="objectRef.resource" type="pcre2">^nodes$</field>
    <field name="objectRef.name" type="pcre2">^k3s-01$</field>
    <field name="responseStatus.code" type="pcre2">^200$</field>
    <description>Routine K3s node status reconciliation.</description>
    <group>audit_benign,controller_reconciliation,</group>
  </rule>

  <rule id="100219" level="1">
    <if_sid>100210</if_sid>
    <field name="user.username" type="pcre2">^system:serviceaccount:monitoring:victoria-metrics-pilot-victoria-metrics-operator$</field>
    <field name="verb" type="pcre2">^(?:patch|update)$</field>
    <field name="objectRef.resource" type="pcre2">^services$</field>
    <field name="responseStatus.code" type="pcre2">^200$</field>
    <description>Routine VictoriaMetrics Operator service reconciliation.</description>
    <group>audit_benign,controller_reconciliation,</group>
  </rule>

  <rule id="100220" level="1">
    <if_sid>100210</if_sid>
    <field name="user.username" type="pcre2">^system:serviceaccount:external-secrets:external-secrets$</field>
    <field name="verb" type="pcre2">^(?:patch|update)$</field>
    <field name="objectRef.resource" type="pcre2">^(?:externalsecrets|clustersecretstores)$</field>
    <field name="objectRef.subresource" type="pcre2">^status$</field>
    <field name="responseStatus.code" type="pcre2">^200$</field>
    <description>Routine External Secrets status reconciliation.</description>
    <group>audit_benign,controller_reconciliation,</group>
  </rule>

  <rule id="100221" level="1">
    <if_sid>100209</if_sid>
    <field name="user.username" type="pcre2">^(?:system:serviceaccount:velero:velero-server|system:serviceaccount:kube-system:job-controller|system:kube-scheduler|system:serviceaccount:kube-system:generic-garbage-collector)$</field>
    <field name="objectRef.namespace" type="pcre2">^velero$</field>
    <field name="objectRef.resource" type="pcre2">^(?:pods|jobs)$</field>
    <description>Routine Velero backup workload lifecycle.</description>
    <group>audit_benign,scheduled_backup,</group>
  </rule>

  <rule id="100222" level="1">
    <if_sid>100210</if_sid>
    <field name="user.username" type="pcre2">^system:serviceaccount:keycloak:keycloak-db$</field>
    <field name="verb" type="pcre2">^patch$</field>
    <field name="objectRef.resource" type="pcre2">^clusters$</field>
    <field name="objectRef.subresource" type="pcre2">^status$</field>
    <field name="objectRef.namespace" type="pcre2">^keycloak$</field>
    <field name="objectRef.name" type="pcre2">^keycloak-db$</field>
    <field name="responseStatus.code" type="pcre2">^200$</field>
    <description>Routine keycloak-db CloudNativePG status reconciliation.</description>
    <group>audit_benign,controller_reconciliation,</group>
  </rule>
</group>
