<agent_config os="Linux">
  <syscheck>
    <disabled>no</disabled>
    <frequency>43200</frequency>
    <scan_on_start>yes</scan_on_start>
    <directories check_all="yes" realtime="yes">/etc/pve,/etc/network,/etc/ssh,/etc/sudoers.d</directories>
    <directories check_all="yes" realtime="yes">/root</directories>
    <directories check_all="yes">/usr/local/bin,/usr/local/sbin</directories>
    <ignore>/etc/pve/.rrd</ignore>
    <ignore>/etc/pve/.vmlist</ignore>
    <ignore>/etc/pve/nodes/pve1/lrm_status</ignore>
    <ignore>/etc/pve/nodes/pve2/lrm_status</ignore>
    <ignore type="sregex">^/etc/pve/nodes/pve[12]/lrm_status.tmp.[0-9]+$</ignore>
    <ignore type="sregex">.log$|.swp$</ignore>
    <skip_nfs>yes</skip_nfs>
  </syscheck>

  <wodle name="syscollector">
    <disabled>no</disabled>
    <interval>1h</interval>
    <scan_on_start>yes</scan_on_start>
    <hardware>yes</hardware>
    <os>yes</os>
    <network>yes</network>
    <packages>yes</packages>
    <ports all="no">yes</ports>
    <processes>yes</processes>
  </wodle>

  <sca>
    <enabled>yes</enabled>
    <scan_on_start>yes</scan_on_start>
    <interval>12h</interval>
  </sca>

  <localfile>
    <log_format>command</log_format>
    <command>/usr/local/sbin/sec1-package-status</command>
    <frequency>21600</frequency>
    <alias>package-status</alias>
  </localfile>

</agent_config>
